{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "phantom",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "c0818b16-3f41-4d45-8bc4-caf2b5b6cfe5","database_name": "phantom" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "b60903b0aa3e461f8777308b54896e8e" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
